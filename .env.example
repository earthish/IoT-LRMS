# Copy to .env and fill in real values. Never commit .env.
# Generate a key with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Only emails on exactly these domains may sign in (employees, students)
ALLOWED_EMAIL_DOMAINS=xim.edu.in,stu.xim.edu.in

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Database: sqlite3 for early local dev, postgresql later
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
